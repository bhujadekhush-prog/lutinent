{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorts-studio-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shorts-studio-db",
      "database_id": "be5de940-4468-4171-aa41-47d135c9fc3f"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}